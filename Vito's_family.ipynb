   "source": [
    "x=int(input())\n",
    "for i in range(x):\n",
    "    #讀取排列\n",
    "    data=input().split()\n",
    "    n=int(data[0])\n",
    "    list1=[int(j) for j in data[1:]]\n",
    "    list1.sort()\n",
    "\n",
    "    #奇數個時是真正的中間值\n",
    "    #偶數個時取中間兩個其中之一也可以\n",
    "    mid=list1[n//2]\n",
    "    anser=sum(abs(mid-j) for j in list1)\n",
    "    print(anser)\n",
    "\n",
    "        \n",
    "\n"
   ]
  }
 ],
